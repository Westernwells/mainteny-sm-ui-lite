    "zustand": "^4.0.0-rc.1"
  },
  "scripts": {
    "prepare_env": "node create_env.mjs",
    "start": "vite",
    "build": "tsc && vite build",
    "test": "vite test",
    "start:stage": "env-cmd -f .env.stage vite --mode stage",
    "start:prod": "env-cmd -f .env.prod vite --mode prod",
    "build:stage": "env-cmd -f .env.stage tsc && vite build --mode stage",
    "build:prod": "env-cmd -f .env.prod tsc && vite build  --mode prod",
    "lint": "eslint --fix \"./src/**/*.{js,jsx,ts,tsx,json}\"",
    "format": "prettier --write \"./src/**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "check-types": "tsc --pretty --noEmit",
    "check-format": "prettier --check \"./src/**/*.{js,jsx,ts,tsx,json}\"",
    "check-lint": "eslint . --ext ts --ext tsx --ext js",
    "check-all": "yarn check-format && yarn check-lint && yarn check-types",
    "cypress:run": "cypress run --config video=false --e2e && cypress run --config video=false --component"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@testing-library/cypress": "^10.0.1",
    "@types/google-map-react": "^2.1.5",
    "@types/mixpanel-browser": "^2.38.0",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/react-helmet": "^6.1.5",
    "@types/react-pdf": "^6.2.0",
    "@types/react-window": "^1.8.8",
    "@types/supercluster": "^7.1.0",
    "@typescript-eslint/eslint-plugin": "^6.13.1",
    "@typescript-eslint/parser": "^6.13.1",
    "@vitejs/plugin-react": "^4.2.0",
    "cypress": "^13.6.0",
    "eslint": "^8.55.0",
    "eslint-config-airbnb": "19.0.4",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-cypress": "^2.15.1",
    "eslint-plugin-import": "^2.25.3",
    "eslint-plugin-jest": "^27.6.0",
    "eslint-plugin-jsx-a11y": "^6.5.1",
    "eslint-plugin-react": "^7.28.0",
    "eslint-plugin-react-hooks": "^4.3.0",
    "husky": "4",
    "lint-staged": "^12.3.4",
    "prettier": "^2.5.1",
    "react-window": "^1.8.10",
    "typescript": "latest",
    "vite": "^4.0.4",
    "vite-plugin-shim-react-pdf": "^1.0.7",
    "vite-plugin-svgr": "^2.4.0",
    "vite-tsconfig-paths": "^4.2.1"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx,json}": [
      "eslint --fix"
    ],
    "src/**/*.{js,jsx,ts,tsx,json,css,scss,md}": [
      "prettier --write"
    ]
  }
}
