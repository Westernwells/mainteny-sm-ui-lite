{
  "name": "sm-ui",
  "version": "5.0.0",
  "private": true,
  "scripts": {
    "prepare_env": "node create_env.mjs",
    "start": "vite",
    "build": "tsc && vite build",
    "coverage": "vitest run --coverage",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "cy": "cypress run",
    "start:stage": "env-cmd -f .env.stage vite --mode stage",
    "start:prod": "env-cmd -f .env.prod vite --mode prod",
    "build:stage": "env-cmd -f .env.stage tsc && vite build --mode stage",
    "build:prod": "env-cmd -f .env.prod tsc && vite build  --mode prod",
    "lint": "eslint --fix \"./src/**/*.{js,jsx,ts,tsx,json}\"",
    "format": "prettier --write \"./src/**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "check-types": "tsc --pretty --noEmit",
    "check-format": "prettier --check \"./src/**/*.{js,jsx,ts,tsx,json}\"",
    "check-lint": "eslint . --ext ts --ext tsx --ext js",
    "check-all": "yarn check-format && yarn check-lint && yarn check-types",
    "cypress:install": "cypress install",
    "cypress:e2e": "cypress run --config video=false --e2e",
    "cypress:component": "cypress run --config video=false --component",
    "cypress:run": "yarn cypress:e2e && yarn cypress:component",
    "cypress:split-e2e": "cypress run --config video=false --e2e --env split=true",
    "vitest:run": "vitest run --coverage --reporter junit --output-file results/vitest-[hash].xml",
    "playwright:test": "playwright test",
    "playwright:test:ui": "playwright test --ui",
    "playwright:install": "playwright install chromium"
  },
